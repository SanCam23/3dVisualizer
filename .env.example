# ==============================================================================
# 3D VISUALIZER - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and configure your credentials
# ==============================================================================

# Supabase Project Credentials (obtain from https://supabase.com/dashboard)
# Note: If omitted, the application runs in local Mock/Demo mode with sample 3D models.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Required for server-side administrative storage & DB writes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket name (default: models3d)
SUPABASE_STORAGE_BUCKET=models3d

# Blender Headless Executable Path (Optional: autodetected if installed in standard location)
# On Windows: C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# On Linux/Docker: /usr/bin/blender
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Secret token to protect the worker endpoints (optional)
WORKER_SECRET_TOKEN=my_secure_worker_secret_token_12345

